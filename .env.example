# Copiar a .env y ajustar:  cp .env.example .env
# Credenciales EXCLUSIVAMENTE para desarrollo local. Nunca usar en producción
# ni subir el archivo .env al repositorio.

# --- PostgreSQL (usado por compose.yaml) ---
POSTGRES_DB=nexo_joven_360
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo_local_dev
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
APP_DEBUG=true
# Host "localhost" para ejecutar el backend fuera de Docker.
# Dentro de Docker Compose se sobrescribe automáticamente con el host "db".
DATABASE_URL=postgresql+psycopg://nexo:nexo_local_dev@localhost:5432/nexo_joven_360
# Lista JSON de orígenes permitidos
CORS_ORIGINS=["http://localhost:5173"]
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
